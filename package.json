{
  "name": "blogosphere",
  "version": "1.0.0",
  "description": "Blogosphere — full-stack MERN blog platform",
  "private": true,
  "scripts": {
    "start": "node api/index.js",
    "install:all": "npm --prefix api install && npm --prefix client install",
    "dev:api": "npm --prefix api run dev",
    "dev:client": "npm --prefix client run dev",
    "test": "npm --prefix api test && npm --prefix client test",
    "build": "npm --prefix client run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^6.13.8",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "sanitize-html": "^2.13.0",
    "zod": "^3.23.8"
  }
}
